# Version 2 root-owned compatibility baselines.
#
# The three version families are independent. They currently start at the
# same numeric baseline because each is entering its first durable Version 2
# shape, not because their values are coupled.

DELEARNER_SQLITE_SCHEMA_MAJOR=1
DELEARNER_SQLITE_SCHEMA_MINOR=5
DELEARNER_SQLITE_SCHEMA_VERSION=1.5

DELEARNER_POSTGRESQL_SCHEMA_MAJOR=1
DELEARNER_POSTGRESQL_SCHEMA_MINOR=6
DELEARNER_POSTGRESQL_SCHEMA_VERSION=1.6

DELEARNER_SYNC_API_CONTRACT_MAJOR=2
DELEARNER_SYNC_API_CONTRACT_MINOR=1
DELEARNER_SYNC_API_CONTRACT_VERSION=2.1
DELEARNER_SYNC_API_ROUTE_MAJOR=/api/v2

# Approved additive targets frozen by V2-20-01 and active after V2-20-02/03.
DELEARNER_V2_20_TARGET_SQLITE_SCHEMA_VERSION=1.5
DELEARNER_V2_20_TARGET_POSTGRESQL_SCHEMA_VERSION=1.5
DELEARNER_V2_20_TARGET_SYNC_API_CONTRACT_VERSION=2.1
DELEARNER_V2_20_TARGET_SYNC_API_ROUTE_MAJOR=/api/v2

DELEARNER_VERSION_BASELINES_INDEPENDENT=true
DELEARNER_COMPAT_SAME_MAJOR_INTEROPERATES=true
DELEARNER_COMPAT_MINOR_BACKWARD_COMPATIBLE=true
DELEARNER_COMPAT_UNKNOWN_OPTIONAL_FIELDS=ignore
DELEARNER_COMPAT_UNKNOWN_REQUIRED_SEMANTICS=reject
