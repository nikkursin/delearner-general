# Copy to .env for local integration runs. Do not commit .env.

# Backend HTTP service exposed by the root integration environment.
DELEARNER_BACKEND_HOST_PORT=8080
DELEARNER_BACKEND_CONTAINER_PORT=8080

# PostgreSQL service used by Version 2 backend integration work.
DELEARNER_POSTGRES_HOST_PORT=5432
POSTGRES_DB=delearner
POSTGRES_USER=delearner
POSTGRES_PASSWORD=change_me_for_local_dev

# Connection values exposed to backend containers. The current backend may not
# consume all of them until the PostgreSQL baseline task lands.
DELEARNER_DATABASE_HOST=postgres
DELEARNER_DATABASE_PORT=5432
DELEARNER_DATABASE_NAME=delearner
DELEARNER_DATABASE_USER=delearner
DELEARNER_DATABASE_PASSWORD=change_me_for_local_dev
